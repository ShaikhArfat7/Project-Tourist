rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidString(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // 1. Tourist User Profiles: strictly private to the authenticated owner
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll(['fullName', 'email'])
        && isValidString(request.resource.data.fullName, 120)
        && isValidString(request.resource.data.email, 180)
        && !('password' in request.resource.data);
      allow delete: if isOwner(userId);
    }

    // 2. Confirmed SOS Incidents: authenticated users can create and view only their own logs
    match /incidents/{incidentId} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.confirmedByUser == true;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
